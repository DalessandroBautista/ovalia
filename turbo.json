{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "WEB_PORT",
    "API_PORT",
    "API_HOST",
    "NEXT_PUBLIC_API_URL",
    "HIGHLIGHTLY_API_KEY",
    "HIGHLIGHTLY_API_BASE_URL",
    "LIVE_FEED_CACHE_TTL_MS",
    "DATABASE_URL",
    "ADMIN_TOKEN",
    "SESSION_SECRET",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
