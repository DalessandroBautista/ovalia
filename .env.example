NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL pública canónica de la web (SEO, robots y sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Orígenes permitidos por CORS en la API (coma-separados). En prod, el dominio real.
WEB_ORIGIN=http://localhost:3000
# Token legacy del admin. En producción preferir sesiones con rol editor/admin;
# vacío deshabilita el acceso por token, no el acceso por sesión.
ADMIN_TOKEN=
# Límites de rate limit de la API.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Frecuencias de ingestión (segundos). Opcionales; hay defaults en el worker.
INGEST_FREQ_CATALOG=604800
INGEST_FREQ_FIXTURES=21600
INGEST_FREQ_RESULTS=600
INGEST_FREQ_STANDINGS=3600
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_API_BASE_URL=https://rugby.highlightly.net
LIVE_FEED_CACHE_TTL_MS=900000
DATABASE_URL=postgresql://ovalia:ovalia@localhost:54329/ovalia
# En serverless conviene 2–3; local puede usar 10.
DATABASE_POOL_MAX=10
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# La API acepta un notifier inyectable para verificación/reset; sin proveedor
# configurado las solicitudes son genéricas y no se envían correos.
AUTH_EMAIL_PROVIDER=disabled
